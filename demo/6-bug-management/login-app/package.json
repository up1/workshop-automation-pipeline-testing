{
  "name": "login-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node src/server.js",
    "test": "playwright test",
    "test:ui:mock": "playwright test --project=ui-mock",
    "test:ui:real": "playwright test --project=ui-real",
    "test:api": "playwright test --project=api",
    "har:record": "UPDATE_HAR=1 playwright test --project=ui-mock tests/ui/login.har.spec.ts",
    "report": "playwright show-report"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0"
  }
}
